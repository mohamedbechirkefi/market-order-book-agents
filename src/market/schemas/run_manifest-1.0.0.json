{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market.run_manifest/1.0.0",
  "title": "MARKET run manifest",
  "description": "Provenance of one batch of runs. Covered by NOTICE.md (LicenseRef-MARKET-NC-Research-1.0).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "label", "exp_id", "batch_id", "created_utc", "git", "environment", "protocol", "runs"],
  "properties": {
    "schema": {"type": "string", "enum": ["market.run_manifest"]},
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "label": {"type": "string", "enum": ["exploratory", "confirmatory"]},
    "exp_id": {"type": "string"},
    "batch_id": {"type": "string"},
    "created_utc": {"type": "string"},
    "experiment_config_path": {"type": ["string", "null"]},
    "experiment_config_sha256": {"type": ["string", "null"]},
    "git": {
      "type": "object",
      "required": ["revision", "dirty"],
      "properties": {"revision": {"type": ["string", "null"]}, "dirty": {"type": ["boolean", "null"]}}
    },
    "environment": {
      "type": "object",
      "required": ["python", "numpy", "market", "os", "machine", "cpu", "cpu_count"]
    },
    "protocol": {
      "type": "object",
      "required": ["path", "sha256", "frozen"],
      "properties": {"path": {"type": ["string", "null"]}, "sha256": {"type": ["string", "null"]}, "frozen": {"type": "boolean"}}
    },
    "workers": {"type": "integer", "minimum": 1},
    "wall_time_s": {"type": "number", "minimum": 0},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "arm", "seed", "config_hash", "status", "runtime_s", "peak_rss_bytes", "result_path", "result_sha256"],
        "properties": {
          "run_id": {"type": "string"},
          "arm": {"type": "string"},
          "seed": {"type": "integer", "minimum": 0},
          "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"type": "string", "enum": ["ok", "failed"]},
          "runtime_s": {"type": "number", "minimum": 0},
          "peak_rss_bytes": {"type": ["integer", "null"]},
          "result_path": {"type": "string"},
          "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
